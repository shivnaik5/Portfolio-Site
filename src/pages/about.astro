---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BasePage from '@/components/BasePage.astro';
import SectionHeading from '@/components/shared/SectionHeading.astro';
import AboutMe from '@/components/about/AboutMe.astro';
import SkillDots from '@/components/about/SkillDots/SkillDots.astro';
import { getAboutContent, getSkills, getSiteSettings } from '@/lib/content';

const about = await getAboutContent();
const skills = await getSkills();
const { photoUrl } = await getSiteSettings();
---

<BaseLayout title="About — Shivang Naik">
  <BasePage>
    <div class="animate-fadein">
      <div
        class:list={[
          photoUrl && 'flex flex-col gap-8 md:flex-row md:items-center md:justify-between',
        ]}
      >
        <SectionHeading
          title={about.title}
          subtitle={about.subTitle}
          class={photoUrl ? 'mb-0 flex-1' : ''}
        />
        {
          photoUrl && (
            <div class="relative mx-auto h-48 w-48 flex-shrink-0 overflow-hidden rounded-full border-4 border-surface shadow-lg md:h-56 md:w-56">
              <img src={photoUrl} alt="Shivang Naik" class="h-full w-full object-cover" />
            </div>
          )
        }
      </div>

      <div>
        {about.aboutMe.map((element) => <AboutMe title={element.title} description={element.description} />)}
      </div>

      <SkillDots skills={skills} />
    </div>
  </BasePage>
</BaseLayout>
