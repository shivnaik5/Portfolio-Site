---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BasePage from '@/components/BasePage.astro';
import SectionHeading from '@/components/shared/SectionHeading.astro';
import projects from '@/data/projects.json';

interface Project {
  title: string;
  route: string;
  blurb: string;
  tags: string[];
  status: 'live' | 'planned';
}

const entries = projects as Project[];
---

<BaseLayout title="Projects — Shivang Naik">
  <BasePage>
    <div class="animate-fadein">
      <SectionHeading
        title="Things I built for the fun of it"
        subtitle="Small interactive pieces, each one an excuse to learn something. Best viewed on a machine with a mouse."
      />

      <div class="mt-10 grid gap-4 sm:grid-cols-2">
        {
          entries.map((project) => {
            const isLive = project.status === 'live';
            const Tag = isLive ? 'a' : 'div';
            return (
              <Tag
                href={isLive ? project.route : undefined}
                class:list={[
                  'group flex flex-col rounded-2xl border border-surface bg-surface/50 p-6 transition-all duration-200',
                  isLive ? 'hover:-translate-y-1 hover:border-accent/40 hover:shadow-lg' : 'opacity-60',
                ]}
              >
                <div class="flex items-baseline justify-between gap-3">
                  <h2 class="font-display text-xl font-bold text-foreground">{project.title}</h2>
                  {!isLive && <span class="text-xs whitespace-nowrap text-muted">in progress</span>}
                </div>

                <p class="mt-3 flex-1 text-sm text-muted">{project.blurb}</p>

                <div class="mt-5 flex flex-wrap items-center gap-2">
                  {project.tags.map((tag) => (
                    <span class="rounded-full border border-surface bg-background/60 px-3 py-1 text-xs text-muted">
                      {tag}
                    </span>
                  ))}
                  {isLive && (
                    <span class="ml-auto text-sm font-medium text-accent transition-transform group-hover:translate-x-1">
                      Open →
                    </span>
                  )}
                </div>
              </Tag>
            );
          })
        }
      </div>
    </div>
  </BasePage>
</BaseLayout>
