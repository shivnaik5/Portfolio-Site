---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BasePage from '@/components/BasePage.astro';
import SectionHeading from '@/components/shared/SectionHeading.astro';
import Timeline from '@/components/resume/Timeline.astro';
import { getResumeContent } from '@/lib/content';

const resume = await getResumeContent();
---

<BaseLayout title="Resume — Shivang Naik">
  <BasePage>
    <SectionHeading title={resume.headline} subtitle={resume.description} />
    <Timeline entries={resume.details} />
  </BasePage>
</BaseLayout>
