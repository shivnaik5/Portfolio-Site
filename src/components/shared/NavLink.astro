---
interface Props {
  href: string;
  label: string;
  isActive: boolean;
}

const { href, label, isActive } = Astro.props;
---

<li>
  <a
    href={href}
    class:list={[
      'inline-block rounded-full px-4 py-2 font-sans text-sm font-medium transition-colors',
      isActive ? 'bg-accent/10 text-accent' : 'text-foreground/80 hover:text-accent',
    ]}
  >
    {label}
  </a>
</li>
