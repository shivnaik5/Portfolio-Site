---
const year = new Date().getFullYear();
---

<footer class="border-t border-surface bg-surface px-4 py-8 text-sm text-muted">
  <div class="mx-auto flex max-w-6xl flex-col items-center gap-4 md:flex-row md:justify-between">
    <nav class="flex gap-6">
      <a href="/about" class="transition-colors hover:text-accent">About</a>
      <a href="/resume" class="transition-colors hover:text-accent">Resume</a>
    </nav>

    <div class="flex gap-4">
      <a
        href="https://www.github.com/shivnaik5"
        target="_blank"
        rel="noreferrer"
        class="transition-colors hover:text-accent"
      >
        <i class="devicon-github-original text-lg" />
      </a>
      <a
        href="https://www.linkedin.com/in/shivang-naik"
        target="_blank"
        rel="noreferrer"
        class="transition-colors hover:text-accent"
      >
        <i class="devicon-linkedin-plain text-lg" />
      </a>
    </div>

    <p class="text-xs">
      &copy; {year} Shivang Naik. Built with Astro &amp; Tailwind CSS.
    </p>
  </div>
</footer>
