---
import type { ExperienceEntry } from '@/lib/types';

interface Props {
  entry: ExperienceEntry;
}

const { entry } = Astro.props;
const { company, title, location, date, content } = entry;
---

<li class="relative mb-12 last:mb-0">
  <span class="absolute -left-9 top-1.5 h-3 w-3 rounded-full border-2 border-background bg-accent" />
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <span class="font-display text-lg font-bold text-foreground">{company}</span>
    <span class="text-sm text-muted">{date}</span>
  </div>
  <div class="mt-1 flex flex-wrap items-baseline gap-x-2 text-sm text-muted">
    {title && <span class="font-medium text-foreground">{title}</span>}
    <span>{location}</span>
  </div>
  <ul class="mt-3 list-disc space-y-2 pl-5 text-muted marker:text-accent-warm">
    {content.map((item) => <li>{item}</li>)}
  </ul>
</li>
