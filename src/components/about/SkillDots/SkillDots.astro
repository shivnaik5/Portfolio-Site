---
import SkillChip from './SkillChip.astro';
import type { SkillColumns } from '@/lib/types';

interface Props {
  skills: SkillColumns;
}

const { skills } = Astro.props;
---

<div class="mt-8 flex flex-col gap-4">
  {
    skills.map((group) => (
      <div class="flex flex-wrap gap-3">
        {group.map((skill) => (
          <SkillChip skill={skill} />
        ))}
      </div>
    ))
  }
</div>
