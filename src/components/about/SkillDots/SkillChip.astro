---
import { getCompetencyLevel } from './competencyLevel';
import type { Skill } from '@/lib/types';

interface Props {
  skill: Skill;
}

const { skill } = Astro.props;
const { tech, icon, level } = skill;
const competency = getCompetencyLevel(level);
---

<div
  class="group flex items-center gap-3 rounded-2xl border border-surface bg-surface/50 px-4 py-3 transition-transform duration-200 hover:scale-105"
  aria-label={`${tech}: ${competency.label}`}
>
  {/* Two stacked icons: monochrome by default, the brand-coloured devicon fading in on
      hover. Every skill icon has a `.colored` variant, so none render blank. */}
  <span class="relative inline-flex text-2xl">
    <i
      class={`devicon-${icon} text-foreground transition-opacity duration-200 group-hover:opacity-0`}
      aria-hidden="true"
    />
    <i
      class={`devicon-${icon} colored absolute inset-0 opacity-0 transition-opacity duration-200 group-hover:opacity-100`}
      aria-hidden="true"
    />
  </span>
  <div class="flex flex-col">
    <span class="text-sm font-medium text-foreground">{tech}</span>
    <div class="mt-1 flex gap-1">
      {
        [0, 1, 2].map((index) => {
          const filled = index < competency.dots;
          return (
            <span
              class:list={[
                'h-2 w-2 rounded-full',
                filled ? 'bg-accent-warm group-hover:animate-refill' : 'bg-surface',
              ]}
              style={filled ? `animation-delay: ${index * 90}ms;` : undefined}
            />
          );
        })
      }
    </div>
  </div>
</div>
