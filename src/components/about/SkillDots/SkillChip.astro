---
import { getCompetencyLevel } from './competencyLevel';

const { skill } = Astro.props;
const { tech, icon, years } = skill;
const level = getCompetencyLevel(years);
---

<div
  class="group flex items-center gap-3 rounded-2xl border border-surface bg-surface/50 px-4 py-3 transition-transform duration-200 hover:scale-105"
  aria-label={`${tech}: ${level.label}`}
>
  <i class={`devicon-${icon} text-2xl text-foreground`} aria-hidden="true" />
  <div class="flex flex-col">
    <span class="text-sm font-medium text-foreground">{tech}</span>
    <div class="mt-1 flex gap-1">
      {
        [0, 1, 2].map((index) => {
          const filled = index < level.dots;
          return (
            <span
              class:list={[
                'h-2 w-2 rounded-full',
                filled ? 'bg-accent-warm group-hover:animate-refill' : 'bg-surface',
              ]}
              style={filled ? `animation-delay: ${index * 90}ms;` : undefined}
            />
          );
        })
      }
    </div>
  </div>
</div>
