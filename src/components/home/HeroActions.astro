---
import { getSiteSettings } from '@/lib/content';

interface Props {
  justify?: string;
}

const { justify = 'justify-start' } = Astro.props;
const { resumeUrl, socialLinks } = await getSiteSettings();
---

<div class:list={['mt-8 flex flex-wrap items-center gap-4', justify]}>
  {
    resumeUrl && (
      <a
        href={resumeUrl}
        target="_blank"
        rel="noreferrer"
        class="rounded-full bg-accent px-6 py-3 text-sm font-semibold text-background transition-opacity hover:opacity-90"
      >
        Download Resume
      </a>
    )
  }
  {
    socialLinks.map((link) => (
      <a
        href={link.url}
        target="_blank"
        rel="noreferrer"
        class="flex items-center gap-2 text-sm font-medium text-foreground transition-colors hover:text-accent"
      >
        {link.icon && <i class={`devicon-${link.icon} text-xl`} aria-hidden="true" />}
        {link.label}
      </a>
    ))
  }
</div>
