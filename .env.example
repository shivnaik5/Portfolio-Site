# Copy to .env and fill in from https://sanity.io/manage
#
# With these unset, the site falls back to the local JSON in src/data/ and builds
# normally — useful for a fresh clone or a quick contribution.

# Sanity project ID and dataset. Neither is secret; both are safe to commit.
SANITY_PROJECT_ID=
SANITY_DATASET=production

# Only needed if the dataset is private. A public dataset reads without a token,
# and reads without a token are served from Sanity's CDN.
# SANITY_READ_TOKEN=

# Only used by scripts/migrate-to-sanity.ts. Needs write access — keep it out of
# version control and out of the deployed environment.
# SANITY_WRITE_TOKEN=

# The studio has its own env file: see studio/.env.example. The Sanity CLI reads
# from that directory and only picks up SANITY_STUDIO_-prefixed variables.
